{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "./dist",
    // Pinned so the CLI keeps emitting to dist/cli/, which the bin entry names. src/ holds nothing
    // but the CLI now, and an inferred root would flatten it to dist/.
    "rootDir": "./src",
    "declaration": true,
    "skipLibCheck": true,
    // Pinned so an ancestor directory's node_modules cannot reach this compile. A checkout above
    // this one may depend on @types/bun, whose narrower process.removeListener overloads fail this
    // repo's suites in a fresh clone while passing standalone.
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/__tests__/**"]
}
