{
  "name": "api",
  "version": "0.3.0",
  "description": "Plugin API contract and service registry for the intisy-ai AI-proxy ecosystem.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./generated/engine.d.ts",
      "default": "./generated/engine.js"
    }
  },
  "bin": {
    "intisy-plugin": "dist/cli/main.js"
  },
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intisy-ai/api.git"
  },
  "keywords": [
    "intisy-ai",
    "plugin",
    "api",
    "registry",
    "manifest"
  ],
  "files": [
    "dist/",
    "generated/",
    "schema/",
    "plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && tsc --noEmit -p tsconfig.test.json && npm run schema",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "schema": "node scripts/emit-schema.mjs",
    "docs": "typedoc",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "emit": "npm run emit:contract && npm run emit:teavm",
    "emit:contract": "node scripts/emit-dts.mjs --java-dir java --module :contract --out generated",
    "emit:teavm": "node scripts/emit-dts.mjs --java-dir java --module :teavm --out generated && node scripts/emit-dts.mjs --java-dir java --module :teavm --ext .js --gradle-task :teavm:generateJavaScript --source-dir teavm/build/generated/teavm/js --out generated"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "typedoc": "^0.28.0",
    "vitest": "^3.0.0"
  }
}
