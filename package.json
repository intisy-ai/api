{
  "name": "api",
  "version": "0.1.0",
  "description": "Plugin API contract and service registry for the intisy-ai AI-proxy ecosystem.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "intisy-plugin": "dist/cli/main.js"
  },
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intisy-ai/api.git"
  },
  "keywords": [
    "intisy-ai",
    "plugin",
    "api",
    "registry",
    "manifest"
  ],
  "files": [
    "dist/",
    "schema/",
    "plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && tsc --noEmit -p tsconfig.test.json && npm run schema",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "schema": "node scripts/emit-schema.mjs",
    "docs": "typedoc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "typedoc": "^0.28.0",
    "vitest": "^3.0.0"
  }
}
